{
  "name": "agent-sandbox-app-hosting",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "mise run db:migrate && mise run build",
    "check-all-for-ai": "bun run check-for-ai && bun run test",
    "check-for-ai": "bun install > /dev/null && bun run format > /dev/null 2> /dev/null || true && bun run typecheck && bun run lint",
    "cleanup": "bun run format && bun run lint-fix",
    "deploy": "mise run deploy",
    "deploy:setup": "mise -E ${WB_ENV} run deploy:setup",
    "dev": "WB_ENV=development wb dotenv -- next dev",
    "format": "bun run biome format --write .",
    "lint": "eslint .",
    "lint-fix": "bun run lint --fix",
    "playwright": "playwright",
    "railway": "bunx @railway/cli@latest",
    "start": "WB_ENV=${WB_ENV:-development} wb dotenv -- next start",
    "test": "mise run test-docker",
    "test/ci": "mise run test-docker",
    "test/ci-setup": "bun run playwright install --with-deps",
    "typecheck": "mise run typecheck"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@libsql/client": "^0.17.0",
    "@willbooster/wb": "13.22.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.5",
    "lucide-react": "^0.577.0",
    "mime-types": "^3.0.2",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "uuidv7": "^1.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "kill-port": "^2.0.1",
    "sort-package-json": "3.6.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
